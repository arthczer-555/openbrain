# Copy to .env (never commit .env). Only what you use is needed.
# The CLI loads .env from the instance folder and from the current folder; variables already set win.

# ---- Chatbot model: at least one provider key (set the same ones in Netlify) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Optional hybrid search (models.embeddings in openbrain.config.yaml)
VOYAGE_API_KEY=

# ---- Chatbot auth and admin (Netlify environment; `openbrain deploy` generates them) ----
SESSION_SECRET=
# Hashes only, never the codes: npm run openbrain -- auth hash-code
ACCESS_CODE_HASH=
ADMIN_CODE_HASH=
# "1" for a chat without access code (no sign-in page), only when ACCESS_CODE_HASH is empty
OPENBRAIN_OPEN_ACCESS=
# Google sign-in (auth.mode: google in openbrain.config.yaml)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=
ADMIN_EMAILS=
# Instance folder when it is not the repo root (for example examples/acme)
OPENBRAIN_ROOT=
# "off" when the site is protected by Netlify itself (auth.mode: netlify)
OPENBRAIN_EDGE_GUARD=

# ---- Weekly update (written by `openbrain deploy`; ADMIN_TOKEN is also set on Netlify) ----
OPENBRAIN_URL=
ADMIN_TOKEN=

# ---- Source tokens: local only, never in Netlify or GitHub (a connector of Claude Code needs none) ----
NOTION_TOKEN=
GDRIVE_SA_JSON=
GITHUB_TOKEN=
# Keys of the MCP servers and REST APIs you read, under the names set in inputs.mcp.<name>.auth_env
# and inputs.api.<name>.auth.env, for example:
# ACME_TRACKER_TOKEN=
# ACME_CRM_TOKEN=
