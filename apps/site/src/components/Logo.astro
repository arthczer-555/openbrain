---
// The OpenBrain mark: black rounded square, pink prompt chevron, white cursor underscore.
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 30 30" aria-hidden="true" focusable="false" class="ob-logo">
  <rect width="30" height="30" rx="6" fill="#111114"></rect>
  <path d="M8 10l5 5-5 5" stroke="#F00050" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M15 20h7" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round"></path>
</svg>

<style>
  .ob-logo {
    flex: none;
    display: block;
  }
</style>
