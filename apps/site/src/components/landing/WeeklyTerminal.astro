---
// A real /weekly session: preparation by the CLI, the "Needs you" briefing, the proposed Notion writes, the go-ahead.
const checks: Array<[string, string]> = [
  ["window", "last update 7 days ago"],
  ["drive", "2 files changed, 1 new doc to consolidate"],
  ["slack", "214 messages in 5 followed channels"],
  ["chatbot", "9 unanswered, 3 thumbs down"],
];
const needs: string[] = [
  "The Drive pricing deck says $49, Notion says $45. Which goes into Notion?",
  "A deal moved to won, but nothing describes the scope. Who has it?",
  '4 people asked about CSV exports: add an alias to "Admin analytics"?',
];
---

<section id="weekly" aria-label="Weekly update in the terminal" class="weekly wrap">
  <div class="term">
    <div class="term-bar">
      <span class="dot" aria-hidden="true"></span>
      <span class="dot" aria-hidden="true"></span>
      <span class="dot" aria-hidden="true"></span>
      <span class="term-title">~/acme-brain: claude</span>
    </div>
    <div class="term-body">
      <div><span class="t-accent" aria-hidden="true">&gt;</span> /weekly</div>
      <div class="t-muted">openbrain weekly prepare</div>
      {
        checks.map(([source, detail]) => (
          <div>
            <span class="t-ok">ok</span> {source}: {detail}
          </div>
        ))
      }
      <div class="gap" aria-hidden="true"></div>
      <div class="strong">Needs you ({needs.length})</div>
      {needs.map((item, i) => <div>{i + 1}. {item}</div>)}
      <div class="gap" aria-hidden="true"></div>
      <div class="strong">Notion updates proposed (7) &nbsp; thumbs down reviewed (3/3) &nbsp; new tests (5)</div>
      <div class="gap" aria-hidden="true"></div>
      <div><span class="t-accent" aria-hidden="true">&gt;</span> ok except 2<span class="caret" aria-hidden="true"></span></div>
    </div>
  </div>
</section>

<style>
  .weekly {
    padding-top: 24px;
    padding-bottom: 96px;
  }
  .term {
    background: var(--term-bg);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 80px rgba(17, 17, 20, 0.22);
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--term-line);
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--term-dot);
    flex: none;
  }
  .term-title {
    margin-left: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--term-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .term-body {
    padding: 28px 30px 32px;
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.85;
    color: var(--term-text);
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-wrap: anywhere;
  }
  .strong {
    color: #ffffff;
    font-weight: 700;
  }
  .gap {
    height: 14px;
  }
  .caret {
    display: inline-block;
    width: 9px;
    height: 18px;
    margin-left: 4px;
    vertical-align: -3px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 640px) {
    .weekly {
      padding-bottom: 64px;
    }
    .term-body {
      padding: 20px 18px 24px;
      font-size: 13px;
      line-height: 1.75;
    }
  }
</style>
