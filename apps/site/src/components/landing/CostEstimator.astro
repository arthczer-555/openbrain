---
import { ASSUMPTIONS, HAIKU, OPUS, estimate, formatInt, formatUsd, passagesFor } from "../../lib/cost";
import { withBase } from "../../lib/paths";

const defaultPages = 300;
const defaultQuestions = 50;
const initial = estimate(defaultQuestions);
const opus = OPUS;
const haiku = HAIKU;
---

<section id="cost" aria-labelledby="cost-title" class="cost wrap section split">
  <div class="col-text">
    <span class="kicker">// what it costs</span>
    <h2 id="cost-title" class="h2">Pay per question. Maintenance is on your subscription.</h2>
    <p class="lead">
      The chatbot calls the LLM provider you pick, with a context budget enforced in code, so the cost per question
      stays flat as Notion grows. The weekly update runs in Claude Code on your Claude subscription: no API bill.
    </p>
    <p class="mono-note">Estimate only. Check it on your own questions with <code>openbrain eval</code>.</p>
  </div>

  <div class="col-wide calc">
    <form class="inputs" data-cost-form>
      <label>
        <span>Pages in Notion</span>
        <input type="number" name="pages" min="0" max="100000" step="10" value={defaultPages} inputmode="numeric" />
      </label>
      <label>
        <span>Questions per day</span>
        <input type="number" name="questions" min="0" max="100000" step="5" value={defaultQuestions} inputmode="numeric" />
      </label>
    </form>

    <div class="results" aria-live="polite">
      {
        initial.map((row, i) => (
          <div class:list={["result", { main: i === 0 }]}>
            <span class="result-model">{row.model.label}</span>
            <span class="result-value">
              <strong data-cost-month={row.model.id}>{formatUsd(row.perMonth)}</strong> / month
            </span>
            <span class="result-detail">
              <span data-cost-question={row.model.id}>{formatUsd(row.perQuestion)}</span> per question{i === 0 ? ", template default" : ", cheaper option"}
            </span>
          </div>
        ))
      }
    </div>

    <p class="index-note">
      <span data-cost-passages>{formatInt(passagesFor(defaultPages))}</span> passages in the index (about {ASSUMPTIONS.passagesPerPage} per
      page). The page count does not change the cost per question: it sizes the index, which stays in memory up to
      about {formatInt(ASSUMPTIONS.inMemoryPassages)} passages.
    </p>

    <details class="formula">
      <summary>How it is computed</summary>
      <div class="formula-body">
        <p>
          Per question, about {formatInt(ASSUMPTIONS.inputTokens)} input tokens, of which {formatInt(ASSUMPTIONS.cachedTokens)} are
          the cached fixed prompt, and {formatInt(ASSUMPTIONS.outputTokens)} output tokens.
        </p>
        <pre><code>per question = (10,000 - 2,500) x input + 2,500 x cache read + 400 x output
per month    = per question x questions per day x 30</code></pre>
        <ul>
          <li>
            {opus.label}: ${opus.input} input, ${opus.output} output, ${opus.cacheRead} cache read, per million tokens.
          </li>
          <li>
            {haiku.label}: ${haiku.input} input, ${haiku.output} output per million tokens (prompts under 100K tokens);
            cached tokens counted at the input price, to stay conservative.
          </li>
        </ul>
        <p>
          Public Anthropic API prices, October 2026. Any other provider works too, see <a href={withBase("/docs/models/")}>models</a>.
          The chatbot also has a monthly spending cap (default $50) that pauses it when reached.
        </p>
      </div>
    </details>
  </div>
</section>

<script>
  import { estimate, formatInt, formatUsd, passagesFor } from "../../lib/cost";

  const form = document.querySelector<HTMLFormElement>("[data-cost-form]");

  function readNumber(input: HTMLInputElement | null): number {
    const value = Number(input?.value ?? 0);
    return Number.isFinite(value) && value > 0 ? value : 0;
  }

  function update(): void {
    if (!form) return;
    const pages = readNumber(form.querySelector<HTMLInputElement>("input[name=pages]"));
    const questions = readNumber(form.querySelector<HTMLInputElement>("input[name=questions]"));
    for (const row of estimate(questions)) {
      const month = document.querySelector(`[data-cost-month="${row.model.id}"]`);
      const question = document.querySelector(`[data-cost-question="${row.model.id}"]`);
      if (month) month.textContent = formatUsd(row.perMonth);
      if (question) question.textContent = formatUsd(row.perQuestion);
    }
    const passages = document.querySelector("[data-cost-passages]");
    if (passages) passages.textContent = formatInt(passagesFor(pages));
  }

  form?.addEventListener("input", update);
  form?.addEventListener("submit", (event) => event.preventDefault());
</script>

<style>
  .cost {
    align-items: flex-start;
  }
  .calc {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .inputs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .inputs label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .inputs input {
    min-height: 48px;
    width: 100%;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 700;
  }
  .inputs input:focus-visible {
    border-color: var(--accent-ink);
  }
  .results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .result {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .result.main {
    background: var(--term-bg);
    border-color: var(--term-bg);
    color: var(--term-text);
  }
  .result-model {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .result.main .result-model,
  .result.main .result-detail {
    color: var(--term-muted);
  }
  .result-value {
    font-size: 15px;
  }
  .result-value strong {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .result.main .result-value strong {
    color: #ffffff;
  }
  .result-detail {
    font-size: 14px;
    color: var(--muted);
  }
  .index-note {
    margin: 0;
    font-size: 15px;
    color: var(--body);
  }
  .formula summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent-ink);
    padding: 6px 0;
  }
  .formula-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 8px;
    font-size: 15px;
    color: var(--body);
  }
  .formula-body p,
  .formula-body ul {
    margin: 0;
  }
  .formula-body ul {
    padding-left: 20px;
  }
  .formula-body pre {
    margin: 0;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 13px;
    line-height: 1.7;
    overflow-x: auto;
    color: var(--ink-2);
  }
  .mono-note code {
    color: var(--ink-2);
  }
  @media (max-width: 640px) {
    .calc {
      padding: 18px;
    }
    .inputs,
    .results {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
